{
  "name": "stylelora-web",
  "version": "0.59.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/package-web.mjs",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0 && node scripts/check-design.mjs",
    "format": "prettier --write src tests e2e scripts *.ts *.js",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript ../.test-tmp/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.0",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-virtual": "3.14.17",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
